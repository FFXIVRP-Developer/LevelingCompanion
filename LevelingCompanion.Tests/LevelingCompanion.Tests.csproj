<Project Sdk="Microsoft.NET.Sdk">
    <!-- The plugin's rules tested outside the game, no Dalamud running. The plugin is built for the tests in Debug into
         obj\plugin, never into bin\Release, which the game clients load as a dev plugin. Run with dotnet test. -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows8.0</TargetFramework>
        <Platforms>x64</Platforms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(MSBuildThisFileDirectory)..\..\Profiles\Me\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LevelingCompanion\LevelingCompanion.csproj"
                          AdditionalProperties="Configuration=Debug;Platform=x64;DalamudLibPath=$(DalamudLibPath);OutDir=$(MSBuildThisFileDirectory)obj\plugin\;OutputPath=$(MSBuildThisFileDirectory)obj\plugin\" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Dalamud" HintPath="$(DalamudLibPath)Dalamud.dll" />
    </ItemGroup>
</Project>